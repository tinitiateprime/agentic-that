NEXT_PUBLIC_TELEGRAM_DASHBOARD_URL=/console
NEXT_PUBLIC_WHATSAPP_DASHBOARD_URL=/dashboard
TELEGRAM_API_URL=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Required by the deployed Telegram API. Generate different random values.
SESSION_ENCRYPTION_KEY=
USER_PROVISIONING_KEY=
SESSION_COOKIE_SECURE=true

# Publish Queue Runner. The local companion uses JSON during this phase.
PUBLISH_QUEUE_DATA_PATH=./data/store.json
# Optional on Netlify. Set only to the HTTPS origin of a separately hosted persistent browser runner.
PUBLISH_QUEUE_API_URL=
PUBLISH_QUEUE_SERVICE_PORT=8792
# Comma-separated sites allowed to use the local companion. Include your deployed Netlify origin.
PUBLISH_QUEUE_WEB_ORIGIN=http://127.0.0.1:3000,http://localhost:3000,https://agentic-that.netlify.app
PUBLISH_QUEUE_AUTH_TOKEN_SECRET=
PUBLISH_QUEUE_OPERATIONS_MANAGER_PASSWORD=
PUBLISH_QUEUE_SCHEDULER_TIMEZONE=Asia/Kolkata
PUBLISH_QUEUE_MAX_CONCURRENT_ACCOUNTS=2
# review prevents a possible duplicate after a crash; retry automatically requeues interrupted posts.
PUBLISH_QUEUE_INTERRUPTED_POST_RECOVERY=review
PUBLISH_QUEUE_COMPANION_RESTART_DELAY_MS=5000

# Website-to-server publishing bridge. Keep disabled until the dedicated
# automation worker is deployed behind HTTPS with a matching internal token.
SERVER_AUTOMATION_DASHBOARD_ENABLED=false
SERVER_AUTOMATION_ORIGIN=https://automation-worker.example.com
SERVER_AUTOMATION_INTERNAL_TOKEN=
# Set this to the public Chrome Web Store listing after approval.
NEXT_PUBLIC_PUBLISHING_EXTENSION_URL=
# Stable GitHub Release link used by the publishing setup screen.
NEXT_PUBLIC_PUBLISHING_COMPANION_DOWNLOAD_URL=https://github.com/tinitiateprime/agentic-that/releases/latest/download/AgenticThat-Companion-Portable.zip

# AgenticThat website accounts. Netlify uses Blobs; local development uses JSON.
PLATFORM_AUTH_DATA_PATH=data/platform-auth.json
# Required in production. These users are the only users allowed into /admin-center.
PLATFORM_SUPER_ADMIN_EMAILS=admin@example.com
# New self-service accounts receive their selected roles for this many days.
PLATFORM_FREE_TRIAL_DAYS=7
# Temporary team-testing mode. Set to false and redeploy to restore the stored
# trial duration, module access, and usage quotas.
NEXT_PUBLIC_TEAM_TESTING_FULL_ACCESS=true
# shadow logs central denials while legacy product sessions continue; enforce blocks them.
RBAC_ENFORCEMENT_MODE=shadow

# Five-minute Ed25519 service JWTs. Keep the PKCS#8 private key only on the
# AgenticThat Next.js deployment; companion services receive only the SPKI public key.
SERVICE_TOKEN_ISSUER=agenticthat
SERVICE_TOKEN_KEY_ID=at-ed25519-v1
SERVICE_TOKEN_PRIVATE_KEY=
SERVICE_TOKEN_PUBLIC_KEY=

WA_PROVIDER=meta
META_API_VERSION=v25.0
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_ID=
META_APP_SECRET=
# Embedded Signup configuration id for the recommended coexistence flow.
META_CONFIGURATION_ID=
META_WEBHOOK_VERIFY_TOKEN=

# Required for encrypted per-workspace Meta, WATI, and monitoring credentials.
# Generate 32 random bytes and store them as 64 hex characters.
CREDENTIAL_ENCRYPTION_KEY=

# WhatsApp application data uses PostgreSQL. Use one connection variable only.
DATABASE_URL=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
BUSINESS_NAME=AgenticThat
WA_FROM=+910000000000
CURRENCY=INR

WATI_API_URL=
WATI_ACCESS_TOKEN=
WATI_WEBHOOK_SECRET=

# Optional read-only WhatsApp Web monitoring service.
BAILEYS_SERVICE_URL=
BAILEYS_API_SECRET=

# Instagram scraper uses public Playwright pages; no Instagram session variables are required.
# Optional maximum age for a clearly labeled recent-success fallback (default: 360 minutes).
INSTAGRAM_CACHE_FALLBACK_MAX_AGE_MINUTES=360

# Facebook scraper uses fresh public browser pages; no Facebook API/session variables are required.
FACEBOOK_SERVICE_PORT=8793
# Per-tab discovery budget; All and Reels are scanned independently.
FACEBOOK_DISCOVERY_TIMEOUT_MS=120000
FACEBOOK_PROFILE_DISCOVERY_LIMIT=300
FACEBOOK_COMMENT_ENRICHMENT_LIMIT=12
FACEBOOK_COMPANION_TOKEN_TTL_SECONDS=7200

# AI Growth Advisor. Create a free server-side key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=25000
