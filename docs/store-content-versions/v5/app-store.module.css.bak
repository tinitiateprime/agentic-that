.appStoreMain,
.appStoreMain * {
  box-sizing: border-box;
}

/* One Store theme: neutral surfaces + the AgenticThat gold. Platform logos are the only other colour. */
.appStoreMain {
  --store-gold: #f5b301;
  --store-gold-gradient: linear-gradient(135deg, #facc15 0%, #fde047 48%, #f59e0b 100%);
  --store-gold-ink: #8a5a00;
  --store-gold-soft: rgba(250, 204, 21, 0.12);
  --store-gold-softer: rgba(250, 204, 21, 0.06);
  --store-gold-line: rgba(217, 154, 6, 0.32);
  --store-gold-glow: 0 8px 24px rgba(245, 158, 11, 0.22);
  --store-ink: #111827;
  --store-card: #ffffff;
  --store-card-hover: #fffdf6;
  --store-line: rgba(15, 23, 42, 0.08);
  --store-line-strong: rgba(15, 23, 42, 0.14);
  --store-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 6px 20px rgba(15, 23, 42, 0.05);
  --store-shadow-hover: 0 2px 4px rgba(15, 23, 42, 0.04), 0 18px 40px rgba(15, 23, 42, 0.09);

  width: min(1220px, calc(100% - 40px));
  margin: 0 auto;
  padding: 26px 0 72px;
  color: var(--ai-text);
}

.appStoreMain a {
  color: inherit;
  text-decoration: none;
}

/* Header */

.storeHeader {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  padding: 44px 24px 34px;
  border: 1px solid var(--store-line);
  border-radius: 28px;
  background:
    radial-gradient(60% 90% at 50% -10%, rgba(250, 204, 21, 0.2), transparent 70%),
    radial-gradient(40% 60% at 100% 100%, rgba(245, 158, 11, 0.08), transparent 70%),
    linear-gradient(180deg, #fffdf5, var(--store-card));
  box-shadow: var(--store-shadow);
}

.storeHeader::before {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(rgba(138, 90, 0, 0.09) 1px, transparent 1px);
  background-size: 22px 22px;
  mask-image: radial-gradient(70% 80% at 50% 0%, #000, transparent 75%);
  -webkit-mask-image: radial-gradient(70% 80% at 50% 0%, #000, transparent 75%);
  pointer-events: none;
  content: "";
}

.storeHeader > * {
  position: relative;
}

.storeTitle {
  width: 100%;
  text-align: center;
}

.storeTitle h1 {
  margin: 0;
  background: linear-gradient(115deg, #111827 24%, #283242 57%, #a77105 82%, #d39209 100%);
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  font-size: clamp(52px, 5vw, 66px);
  font-weight: 700;
  letter-spacing: -0.045em;
  line-height: 1.05;
}

.storeIntro {
  max-width: 660px;
  margin: 16px auto 0;
  color: var(--ai-text-muted);
  font-size: 17px;
  line-height: 1.6;
  text-align: center;
}

.storeSearch {
  display: grid;
  grid-template-columns: 22px minmax(0, 1fr) auto;
  gap: 11px;
  align-items: center;
  width: min(660px, 100%);
  min-height: 54px;
  align-self: center;
  margin-top: 26px;
  padding: 0 9px 0 18px;
  border: 1px solid var(--store-line-strong);
  border-radius: 16px;
  background: var(--store-card);
  box-shadow: 0 6px 22px rgba(15, 23, 42, 0.06);
  color: var(--ai-text-faint);
  transition: border-color 150ms ease, box-shadow 150ms ease;
}

.storeSearch:focus-within {
  border-color: var(--store-gold);
  box-shadow: 0 0 0 4px var(--store-gold-soft), 0 10px 28px rgba(15, 23, 42, 0.08);
  color: var(--store-gold-ink);
}

.storeSearch input {
  width: 100%;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--store-ink);
  font: inherit;
  font-size: 15px;
}

.storeSearch input::placeholder {
  color: var(--ai-text-faint);
}

.storeSearch button {
  padding: 8px 12px;
  border: 0;
  border-radius: 10px;
  background: var(--store-gold-soft);
  color: var(--store-gold-ink);
  cursor: pointer;
  font: inherit;
  font-size: 12px;
  font-weight: 750;
}

.searchAction {
  display: grid;
  width: 36px;
  height: 36px;
  place-items: center;
  border-radius: 11px;
  background: var(--store-gold-gradient);
  box-shadow: var(--store-gold-glow);
  color: #171203;
}

.categoryShortcuts {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 18px;
}

.categoryShortcuts > span {
  margin-right: 4px;
  color: var(--ai-text-faint);
  font-size: 12px;
  font-weight: 650;
}

.categoryShortcuts > a {
  display: inline-flex;
  min-height: 34px;
  align-items: center;
  gap: 7px;
  padding: 0 14px;
  border: 1px solid var(--store-line-strong);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.8);
  color: var(--ai-text-muted);
  font-size: 12px;
  font-weight: 640;
  transition: border-color 150ms ease, background 150ms ease, color 150ms ease, transform 150ms ease, box-shadow 150ms ease;
}

.categoryShortcuts > a svg {
  color: var(--store-gold-ink);
}

.categoryShortcuts > a:hover {
  border-color: var(--store-gold-line);
  background: var(--store-gold-soft);
  color: var(--store-ink);
  box-shadow: 0 4px 14px rgba(245, 158, 11, 0.14);
  transform: translateY(-1px);
}

.categoryShortcuts > a:focus-visible {
  outline: 3px solid var(--store-gold-soft);
  outline-offset: 2px;
}

/* Omnichannel panels (Messaging, Publishing) */

.featureStrip {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  padding-top: 32px;
}

.featureCard {
  position: relative;
  display: flex;
  min-width: 0;
  flex-direction: column;
  overflow: hidden;
  padding: 26px 26px 24px;
  border: 1px solid var(--store-line);
  border-radius: 24px;
  background:
    radial-gradient(90% 120% at 100% 0%, rgba(250, 204, 21, 0.14), transparent 60%),
    var(--store-card);
  box-shadow: var(--store-shadow);
  scroll-margin-top: 24px;
  transition: border-color 180ms ease, box-shadow 180ms ease;
}

.featureCard::before {
  position: absolute;
  inset: 0 0 auto;
  height: 3px;
  background: var(--store-gold-gradient);
  content: "";
}

.featureCard:hover {
  border-color: var(--store-gold-line);
  box-shadow: var(--store-shadow-hover);
}

.featureTop {
  display: flex;
  align-items: center;
  gap: 10px;
}

.featureIcon {
  display: grid;
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  place-items: center;
  border: 1px solid var(--store-gold-line);
  border-radius: 12px;
  background: var(--store-gold-soft);
  color: var(--store-gold-ink);
}

.featureEyebrow {
  color: var(--store-gold-ink);
  font-size: 11.5px;
  font-weight: 760;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.featureCount {
  margin-left: auto;
  padding: 3px 10px;
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.06);
  color: var(--ai-text-muted);
  font-size: 11.5px;
  font-weight: 700;
  white-space: nowrap;
}

.featureCard > h2 {
  margin: 18px 0 0;
  color: var(--store-ink);
  font-size: 26px;
  font-weight: 740;
  letter-spacing: -0.03em;
  line-height: 1.15;
}

.featureCard > p {
  max-width: 460px;
  margin: 8px 0 0;
  color: var(--ai-text-muted);
  font-size: 14.5px;
  line-height: 1.6;
}

.featureChannels {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: auto;
  padding-top: 22px;
}

.featureChannels > a {
  display: inline-flex;
  min-height: 40px;
  align-items: center;
  gap: 8px;
  padding: 0 10px 0 6px;
  border: 1px solid var(--store-line-strong);
  border-radius: 12px;
  background: var(--store-card);
  color: var(--store-ink);
  font-size: 13px;
  font-weight: 650;
  transition: border-color 150ms ease, background 150ms ease, box-shadow 150ms ease, transform 150ms ease;
}

.featureChannels img {
  width: 28px;
  height: 28px;
  padding: 5px;
  border-radius: 8px;
  background: #f6f7f9;
  object-fit: contain;
}

.featureChannels svg {
  color: var(--ai-text-faint);
  transition: transform 150ms ease, color 150ms ease;
}

.featureChannels > a:hover {
  border-color: var(--store-gold-line);
  background: var(--store-card-hover);
  box-shadow: 0 6px 16px rgba(245, 158, 11, 0.16);
  transform: translateY(-1px);
}

.featureChannels > a:hover svg {
  color: var(--store-gold-ink);
  transform: translateX(2px);
}

.featureChannels > a:focus-visible {
  outline: 3px solid var(--store-gold-line);
  outline-offset: 2px;
}

/* Sections */

.categoryStack {
  display: flex;
  flex-direction: column;
  gap: 40px;
  padding-top: 40px;
}

.categorySection {
  scroll-margin-top: 24px;
}

.categoryHeading {
  display: flex;
  align-items: center;
  gap: 11px;
  margin: 0 0 16px;
}

.categoryIcon {
  display: grid;
  width: 36px;
  height: 36px;
  flex: 0 0 36px;
  place-items: center;
  border: 1px solid var(--store-gold-line);
  border-radius: 11px;
  background: var(--store-gold-soft);
  color: var(--store-gold-ink);
}

.categoryHeading > h2 {
  margin: 0;
  color: var(--store-ink);
  font-size: 19px;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.categoryCount {
  display: inline-grid;
  min-width: 24px;
  height: 22px;
  place-items: center;
  padding: 0 7px;
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.06);
  color: var(--ai-text-muted);
  font-size: 11.5px;
  font-weight: 700;
}

.categoryHeading > i {
  height: 1px;
  flex: 1;
  margin-left: 4px;
  background: linear-gradient(90deg, var(--store-gold-line), var(--store-line) 35%, transparent);
}

/* Cards */

.serviceGrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 18px;
}

.serviceCard {
  position: relative;
  display: flex;
  min-width: 0;
  min-height: 200px;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--store-line);
  border-radius: 20px;
  background: var(--store-card);
  box-shadow: var(--store-shadow);
  transition: border-color 180ms ease, box-shadow 180ms ease, background 180ms ease, transform 180ms ease;
}

.serviceCard::before {
  position: absolute;
  inset: 0 0 auto;
  height: 3px;
  background: var(--store-gold-gradient);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 260ms ease;
  content: "";
}

.serviceCard:hover {
  border-color: var(--store-gold-line);
  background: var(--store-card-hover);
  box-shadow: var(--store-shadow-hover);
  transform: translateY(-3px);
}

.serviceCard:hover::before {
  transform: scaleX(1);
}

.serviceCard:focus-visible {
  outline: 3px solid var(--store-gold-line);
  outline-offset: 3px;
}

.cardContent {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  padding: 20px 20px 0;
}

.cardHeader {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 13px;
  align-items: center;
}

.serviceLogo {
  display: grid;
  width: 50px;
  height: 50px;
  place-items: center;
  border: 1px solid var(--store-line);
  border-radius: 15px;
  background: linear-gradient(180deg, #ffffff, #f7f8fa);
  box-shadow: 0 2px 6px rgba(15, 23, 42, 0.06);
  transition: border-color 180ms ease, box-shadow 180ms ease;
}

.serviceCard:hover .serviceLogo {
  border-color: var(--store-gold-line);
  box-shadow: 0 4px 14px rgba(245, 158, 11, 0.16);
}

.serviceLogo img {
  width: 30px;
  height: 30px;
  object-fit: contain;
}

.serviceIdentity {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
}

.serviceIdentity h3 {
  max-width: 100%;
  margin: 0;
  overflow: hidden;
  color: var(--store-ink);
  font-size: 16px;
  font-weight: 740;
  letter-spacing: -0.014em;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.serviceStatus {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 9px;
  border: 1px solid var(--store-line);
  border-radius: 999px;
  background: #f6f7f9;
  color: var(--ai-text-muted);
  font-size: 10.5px;
  font-weight: 680;
  white-space: nowrap;
}

.serviceStatus i {
  width: 6px;
  height: 6px;
  flex: 0 0 6px;
  border-radius: 50%;
  background: #94a3b8;
}

.status_connected,
.status_ready {
  border-color: rgba(16, 185, 129, 0.3);
  background: rgba(16, 185, 129, 0.08);
  color: #047857;
}

.status_connected i,
.status_ready i {
  background: #10b981;
  box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.18);
}

.status_continue,
.status_login {
  border-color: var(--store-gold-line);
  background: var(--store-gold-soft);
  color: var(--store-gold-ink);
}

.status_continue i,
.status_login i {
  background: var(--store-gold);
}

.status_locked i {
  border-radius: 2px;
}

.cardBody {
  flex: 1;
  padding: 14px 0 16px;
}

.cardBody > p {
  display: -webkit-box;
  margin: 0;
  overflow: hidden;
  color: var(--ai-text-muted);
  font-size: 13.5px;
  line-height: 1.6;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.cardAction {
  display: flex;
  min-width: 0;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin: 0 -20px;
  padding: 13px 20px 15px;
  border-top: 1px solid var(--store-line);
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.015), transparent);
}

.capabilityList {
  display: flex;
  min-width: 0;
  flex: 1 1 100%;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
}

.capability {
  display: inline-flex;
  min-width: max-content;
  flex: 0 0 auto;
  align-items: center;
  gap: 5px;
  padding: 3px 9px 3px 4px;
  border: 1px solid var(--store-line);
  border-radius: 999px;
  background: var(--store-card);
  white-space: nowrap;
}

.capability > i {
  display: grid;
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
  place-items: center;
  border-radius: 50%;
  background: var(--store-gold-soft);
  color: var(--store-gold-ink);
}

.capability > small {
  color: var(--ai-text-muted);
  font-size: 10.5px;
  font-weight: 640;
}

.cardAction > strong {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 5px;
  min-height: 34px;
  margin-left: auto;
  padding: 0 12px 0 14px;
  border: 1px solid var(--store-gold-line);
  border-radius: 11px;
  background: var(--store-gold-softer);
  color: var(--store-gold-ink);
  font-size: 12px;
  font-weight: 760;
  white-space: nowrap;
  transition: background 160ms ease, color 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
}

.cardAction > strong svg {
  width: 15px;
  height: 15px;
  transition: transform 160ms ease;
}

.serviceCard:hover .cardAction > strong {
  border-color: transparent;
  background: var(--store-gold-gradient);
  box-shadow: var(--store-gold-glow);
  color: #171203;
}

.serviceCard:hover .cardAction > strong svg {
  transform: translateX(2px);
}

/* Coming soon: quieter tiles so live apps lead */

.serviceCardCompact {
  min-height: 0;
  border-style: dashed;
  border-color: var(--store-line-strong);
  background: rgba(255, 255, 255, 0.6);
  box-shadow: none;
}

.serviceCardCompact .cardContent {
  padding: 16px 18px 0;
}

.serviceCardCompact .serviceLogo {
  width: 42px;
  height: 42px;
  border-radius: 13px;
  box-shadow: none;
}

.serviceCardCompact .serviceLogo img {
  width: 24px;
  height: 24px;
  filter: grayscale(0.35);
  opacity: 0.9;
}

.serviceCardCompact .serviceIdentity h3 {
  font-size: 14.5px;
}

.serviceCardCompact .cardBody {
  padding: 10px 0 16px;
}

.serviceCardCompact .cardBody > p {
  font-size: 12.5px;
  -webkit-line-clamp: 2;
}

.serviceCardCompact:hover {
  border-style: solid;
  background: var(--store-card);
  box-shadow: var(--store-shadow);
  transform: translateY(-2px);
}

.serviceCardCompact:hover .serviceLogo img {
  filter: none;
  opacity: 1;
}

/* Empty search */

.noResults {
  padding: 56px 20px;
  border: 1px dashed var(--store-line-strong);
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.6);
  text-align: center;
}

.noResults h2 {
  margin: 0;
  color: var(--store-ink);
  font-size: 22px;
}

.noResults p {
  margin: 9px 0 0;
  color: var(--ai-text-muted);
  font-size: 14px;
}

.noResults button {
  margin-top: 18px;
  padding: 10px 16px;
  border: 0;
  border-radius: 11px;
  background: var(--store-gold-gradient);
  box-shadow: var(--store-gold-glow);
  color: #171203;
  cursor: pointer;
  font: inherit;
  font-size: 13px;
  font-weight: 750;
}

/* Responsive */

@media (max-width: 1050px) {
  .storeTitle h1 {
    font-size: 50px;
  }

  .featureStrip {
    grid-template-columns: 1fr;
  }

  .storeSearch {
    width: min(600px, 100%);
  }
}

@media (max-width: 720px) {
  .appStoreMain {
    width: calc(100% - 32px);
    padding: 16px 0 54px;
  }

  .storeHeader {
    padding: 30px 16px 24px;
    border-radius: 22px;
  }

  .storeTitle h1 {
    font-size: 38px;
  }

  .storeIntro {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.5;
  }

  .storeSearch {
    width: 100%;
    min-height: 48px;
    align-self: stretch;
    margin-top: 18px;
  }

  .categoryShortcuts {
    gap: 7px;
    margin-top: 15px;
  }

  .categoryShortcuts > span {
    width: 100%;
    margin: 0 0 1px;
    text-align: center;
  }

  .categoryShortcuts > a {
    min-height: 32px;
    padding: 0 11px;
    font-size: 11px;
  }

  .categoryStack {
    gap: 32px;
    padding-top: 32px;
  }

  .serviceGrid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .featureCard {
    padding: 22px 18px 20px;
  }

  .featureCard > h2 {
    font-size: 22px;
  }

  .serviceCard:hover,
  .featureChannels > a:hover {
    transform: none;
  }
}

@media (max-width: 410px) {
  .serviceStatus {
    font-size: 10px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .serviceCard,
  .serviceCard::before,
  .categoryShortcuts > a,
  .featureChannels > a,
  .featureChannels svg,
  .cardAction > strong,
  .cardAction > strong svg {
    transition: none;
  }
}
