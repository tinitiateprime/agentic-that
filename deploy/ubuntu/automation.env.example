# Single-host production requires an encrypted Ubuntu data volume and tested
# encrypted backups. Store the real file with mode 0640.
SERVER_ARCHITECTURE_DEPLOYMENT=production
SERVER_ARCHITECTURE_HOST=127.0.0.1
SERVER_ARCHITECTURE_PORT=8800
SERVER_ARCHITECTURE_ALLOW_PUBLIC_BIND=false
SERVER_ARCHITECTURE_INTERNAL_TOKEN=replace-with-at-least-32-random-characters

SERVER_ARCHITECTURE_DATA_DIR=/var/lib/agenticthat-automation
SERVER_ARCHITECTURE_DATABASE_FILE=/var/lib/agenticthat-automation/automation.db
SERVER_ARCHITECTURE_AUTO_MIGRATE=true
SERVER_SINGLE_HOST_ACKNOWLEDGED=true
SERVER_PROFILE_STORAGE_ENCRYPTED=true
SERVER_BACKUPS_CONFIGURED=true
SERVER_BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
SERVER_LOGIN_TIMEOUT_MS=600000

# Each flag remains an explicit kill switch. This ready-for-use example enables
# the five implemented publishing destinations.
SERVER_LOGIN_ENABLED=true
SERVER_EXECUTION_ENABLED=true
SERVER_INSTAGRAM_PUBLISHING_ENABLED=true
SERVER_FACEBOOK_PUBLISHING_ENABLED=true
SERVER_X_PUBLISHING_ENABLED=true
SERVER_LINKEDIN_PUBLISHING_ENABLED=true
SERVER_YOUTUBE_PUBLISHING_ENABLED=true
SERVER_PUBLISHING_DRY_RUN_ENABLED=true
SERVER_PUBLISHING_PREVIEW_ENABLED=false
SERVER_SCRAPING_ENABLED=false
SERVER_WORKER_POLL_MS=2000
SERVER_LIVE_WORKER_COUNT=1
