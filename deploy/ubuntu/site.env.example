# Runtime environment for the public Next.js website. Keep the real file at
# /etc/agenticthat/site.env with root:agenticthat ownership and mode 0640.
NODE_ENV=production
NEXT_PUBLIC_TEAM_TESTING_FULL_ACCESS=false
RBAC_ENFORCEMENT_MODE=enforce
PLATFORM_SUPER_ADMIN_EMAILS=admin@example.com
PLATFORM_FREE_TRIAL_DAYS=7

# PostgreSQL runs on this same Ubuntu host. Replace the password in the real file.
DATABASE_URL=postgresql://agenticthat:replace-me@127.0.0.1:5432/agenticthat
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-random-bytes-as-hex

# Signed short-lived website-to-service identity tokens. Base64 DER is safe in
# a systemd EnvironmentFile; the private key belongs only in site.env.
SERVICE_TOKEN_ISSUER=agenticthat
SERVICE_TOKEN_KEY_ID=at-ed25519-v1
SERVICE_TOKEN_PRIVATE_KEY=replace-with-base64-pkcs8-private-key
SERVICE_TOKEN_PUBLIC_KEY=replace-with-base64-spki-public-key

# Private loopback services. These values are never sent to the browser.
INSTAGRAM_API_URL=http://127.0.0.1:8791
FACEBOOK_API_URL=http://127.0.0.1:8793
TELEGRAM_API_URL=http://127.0.0.1:8787
SERVER_AUTOMATION_DASHBOARD_ENABLED=true
SERVER_AUTOMATION_ORIGIN=http://127.0.0.1:8800
SERVER_AUTOMATION_INTERNAL_TOKEN=replace-with-the-same-random-worker-token

NEXT_PUBLIC_TELEGRAM_DASHBOARD_URL=/console
NEXT_PUBLIC_WHATSAPP_DASHBOARD_URL=/dashboard
PUBLISH_QUEUE_UPLOAD_DIR=/var/lib/agenticthat-site/publishing-uploads
PLATFORM_AUTH_DATA_PATH=/var/lib/agenticthat-site/platform-auth.json
PLATFORM_DOCUMENT_DATA_PATH=/var/lib/agenticthat-site/platform-documents.json

# WhatsApp starts disconnected. Each workspace connects Meta or WATI through
# the website; do not place customer provider tokens in this shared file.
WA_PROVIDER=mock
META_API_VERSION=v25.0
