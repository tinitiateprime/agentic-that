[Unit]
Description=AgenticThat browser automation worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agenticthat
Group=agenticthat
WorkingDirectory=/opt/agenticthat
EnvironmentFile=/etc/agenticthat/automation.env
Environment=HOME=/var/lib/agenticthat-automation
Environment=XDG_CONFIG_HOME=/var/lib/agenticthat-automation/.config
Environment=XDG_CACHE_HOME=/var/lib/agenticthat-automation/.cache
Environment=XDG_DATA_HOME=/var/lib/agenticthat-automation/.local/share
Environment=XDG_RUNTIME_DIR=/run/agenticthat-automation
ExecStartPre=/usr/bin/node --import tsx services/automation-server/src/preflight.ts
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1280x900x24" /usr/bin/node --import tsx services/automation-server/src/server.ts
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=300s
UMask=0077
StateDirectory=agenticthat-automation
StateDirectoryMode=0700
RuntimeDirectory=agenticthat-automation
RuntimeDirectoryMode=0700
ReadWritePaths=/var/lib/agenticthat-automation
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
