# Shared non-public configuration for Telegram and scraper workers. Keep the
# real file at /etc/agenticthat/services.env with mode 0640.
NODE_ENV=production
NEXT_PUBLIC_TEAM_TESTING_FULL_ACCESS=true
RBAC_ENFORCEMENT_MODE=enforce
SERVICE_TOKEN_ISSUER=agenticthat
SERVICE_TOKEN_KEY_ID=at-ed25519-v1
SERVICE_TOKEN_PUBLIC_KEY=replace-with-the-site-public-key-only

SERVICE_HOST=127.0.0.1
SERVICE_PORT=8787
DATA_DIR=/var/lib/agenticthat-telegram
SESSION_ENCRYPTION_KEY=replace-with-32-random-bytes-as-base64url
USER_PROVISIONING_KEY=replace-with-a-different-random-value
SESSION_COOKIE_SECURE=true
CORS_ORIGIN=https://app.example.com
TELEGRAM_API_ID=replace-with-telegram-api-id
TELEGRAM_API_HASH=replace-with-telegram-api-hash
# Public media URLs are downloaded to a private temporary file and uploaded by
# this worker. Defaults shown match Telegram's normal 2 GiB upload ceiling and
# allow 20 minutes for a remote download.
TELEGRAM_MEDIA_MAX_BYTES=2147483648
TELEGRAM_MEDIA_DOWNLOAD_TIMEOUT_MS=1200000

INSTAGRAM_SERVICE_PORT=8791
INSTAGRAM_DATA_DIR=/var/lib/agenticthat-instagram
FACEBOOK_SERVICE_PORT=8793
FACEBOOK_DATA_DIR=/var/lib/agenticthat-facebook
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
GEMINI_API_KEY=
