[Unit]
Description=AgenticThat Instagram scraping worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agenticthat
Group=agenticthat
WorkingDirectory=/opt/agenticthat
EnvironmentFile=/etc/agenticthat/services.env
Environment=HOME=/var/lib/agenticthat-instagram
Environment=XDG_CONFIG_HOME=/var/lib/agenticthat-instagram/.config
Environment=XDG_CACHE_HOME=/var/lib/agenticthat-instagram/.cache
Environment=XDG_DATA_HOME=/var/lib/agenticthat-instagram/.local/share
Environment=XDG_RUNTIME_DIR=/run/agenticthat-instagram
ExecStart=/usr/bin/node --import tsx services/scraping/instagram/src/server.ts
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=300s
UMask=0077
StateDirectory=agenticthat-instagram
StateDirectoryMode=0700
RuntimeDirectory=agenticthat-instagram
RuntimeDirectoryMode=0700
ReadWritePaths=/var/lib/agenticthat-instagram
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
