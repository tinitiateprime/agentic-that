[Unit]
Description=AgenticThat Instagram scraping worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agenticthat
Group=agenticthat
WorkingDirectory=/opt/agenticthat
EnvironmentFile=/etc/agenticthat/services.env
ExecStart=/usr/bin/node --import tsx services/scraping/instagram/src/server.ts
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=300s
UMask=0077
StateDirectory=agenticthat-instagram
ReadWritePaths=/var/lib/agenticthat-instagram
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
