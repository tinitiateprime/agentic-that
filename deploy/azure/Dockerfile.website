FROM node:22.18.0-bookworm-slim AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

FROM dependencies AS builder
COPY . .
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_STANDALONE=true
RUN npm run build

FROM node:22.18.0-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
RUN groupadd --system --gid 10001 agenticthat \
  && useradd --system --uid 10001 --gid agenticthat --home-dir /app agenticthat
COPY --from=builder --chown=agenticthat:agenticthat /app/.next/standalone ./
COPY --from=builder --chown=agenticthat:agenticthat /app/.next/static ./.next/static
COPY --from=builder --chown=agenticthat:agenticthat /app/public ./public
USER agenticthat
EXPOSE 3000
CMD ["node", "server.js"]
