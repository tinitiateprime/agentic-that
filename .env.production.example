# Reference only. Do not copy real values into this committed file.
# Website Web App
NODE_ENV=production
PORT=3000
DATA_STORE=postgres
SUPABASE_DB_URL=postgresql://website-role:REPLACE@host:5432/postgres?sslmode=require
SESSION_COOKIE_SECURE=true
SERVER_AUTOMATION_DASHBOARD_ENABLED=true
SERVER_AUTOMATION_ORIGIN=https://REPLACE-automation.azurewebsites.net
SERVER_AUTOMATION_INTERNAL_TOKEN=REPLACE_WITH_A_32_BYTE_OR_LONGER_RANDOM_SECRET

# Automation Web App
SERVER_ARCHITECTURE_DEPLOYMENT=production
SERVER_ARCHITECTURE_HOST=0.0.0.0
SERVER_ARCHITECTURE_PORT=8800
SERVER_ARCHITECTURE_ALLOW_PUBLIC_BIND=true
SERVER_ARCHITECTURE_DATA_DIR=/var/lib/agenticthat-automation
SERVER_ARCHITECTURE_AUTO_MIGRATE=false
SERVER_ARCHITECTURE_INTERNAL_TOKEN=REPLACE_WITH_THE_SAME_INTERNAL_SECRET
SERVER_DATABASE_ENGINE=postgres
SERVER_AUTOMATION_DATABASE_URL=postgresql://automation-role:REPLACE@host:5432/postgres?sslmode=require
SERVER_DATABASE_POOL_MAX=8
SERVER_STORAGE_BACKEND=azure
AZURE_STORAGE_ACCOUNT_URL=https://REPLACE.blob.core.windows.net
AZURE_PROFILES_CONTAINER=browser-profiles
AZURE_MEDIA_CONTAINER=publishing-media
AZURE_ARTIFACTS_CONTAINER=automation-artifacts
AZURE_KEY_VAULT_URL=https://REPLACE.vault.azure.net
AZURE_PROFILE_KEY_NAME=automation-profile-key
SERVER_PROFILE_STORAGE_ENCRYPTED=true
SERVER_BACKUPS_CONFIGURED=true
SERVER_SINGLE_HOST_ACKNOWLEDGED=true
SERVER_BROWSER_EXECUTABLE_PATH=/usr/local/bin/agenticthat-chromium
SERVER_WORKER_POLL_MS=2000
SERVER_LIVE_WORKER_COUNT=1
SERVER_JOB_TIMEOUT_MS=900000
SERVER_SHUTDOWN_GRACE_MS=120000
SERVER_LOGIN_MAX_CONCURRENT=1

# Keep every live capability disabled during initial deployment.
SERVER_LOGIN_ENABLED=false
SERVER_EXECUTION_ENABLED=false
SERVER_INSTAGRAM_PUBLISHING_ENABLED=false
SERVER_FACEBOOK_PUBLISHING_ENABLED=false
SERVER_X_PUBLISHING_ENABLED=false
SERVER_LINKEDIN_PUBLISHING_ENABLED=false
SERVER_YOUTUBE_PUBLISHING_ENABLED=false
SERVER_PUBLISHING_DRY_RUN_ENABLED=false
SERVER_PUBLISHING_PREVIEW_ENABLED=false
SERVER_SCRAPING_ENABLED=false
