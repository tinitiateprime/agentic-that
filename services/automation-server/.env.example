# Local-only server architecture. Copy this file to .env.local in this folder.
SERVER_ARCHITECTURE_DEPLOYMENT=development
SERVER_DATABASE_ENGINE=sqlite
SERVER_AUTOMATION_DATABASE_URL=
SERVER_DATABASE_POOL_MAX=8
SERVER_STORAGE_BACKEND=local
SERVER_ARCHITECTURE_DATA_DIR=.server-data
SERVER_ARCHITECTURE_DATABASE_FILE=.server-data/automation.db
SERVER_ARCHITECTURE_HOST=127.0.0.1
SERVER_ARCHITECTURE_PORT=8800
SERVER_ARCHITECTURE_INTERNAL_TOKEN=replace-with-a-long-random-local-token
SERVER_BROWSER_EXECUTABLE_PATH=
SERVER_LOGIN_TIMEOUT_MS=600000
SERVER_LOGIN_MAX_CONCURRENT=1

# Safe defaults: the new executor cannot claim or run work until explicitly enabled.
SERVER_EXECUTION_ENABLED=false
SERVER_INSTAGRAM_PUBLISHING_ENABLED=false
SERVER_FACEBOOK_PUBLISHING_ENABLED=false
SERVER_X_PUBLISHING_ENABLED=false
SERVER_LINKEDIN_PUBLISHING_ENABLED=false
SERVER_YOUTUBE_PUBLISHING_ENABLED=false
SERVER_PUBLISHING_DRY_RUN_ENABLED=false
SERVER_PUBLISHING_PREVIEW_ENABLED=false
SERVER_WORKER_POLL_MS=2000
SERVER_LIVE_WORKER_COUNT=1
SERVER_JOB_TIMEOUT_MS=900000
SERVER_SHUTDOWN_GRACE_MS=120000
SERVER_LOGIN_ENABLED=false
SERVER_SCRAPING_ENABLED=false
SERVER_ARCHITECTURE_AUTO_MIGRATE=false

# Keep this false for local development.
SERVER_ARCHITECTURE_ALLOW_PUBLIC_BIND=false

# Required only when SERVER_STORAGE_BACKEND=azure. Production uses managed
# identity; do not add account keys or SAS tokens.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_PROFILES_CONTAINER=browser-profiles
AZURE_MEDIA_CONTAINER=publishing-media
AZURE_ARTIFACTS_CONTAINER=automation-artifacts
AZURE_KEY_VAULT_URL=
AZURE_PROFILE_KEY_NAME=automation-profile-key
SERVER_PROFILE_STORAGE_ENCRYPTED=false
SERVER_BACKUPS_CONFIGURED=false
SERVER_SINGLE_HOST_ACKNOWLEDGED=false

# In local development, the AgenticThat Next.js dashboard may reuse this
# service configuration. Production must configure the bridge in the website
# environment instead and use an HTTPS worker origin.
SERVER_AUTOMATION_DASHBOARD_ENABLED=false
