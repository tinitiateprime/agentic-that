{
  "name": "agentic-that",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run publishing:css && node scripts/dev-all.mjs",
    "dev:all": "npm run dev",
    "dev:site": "node scripts/copy-telegram-console.mjs && node scripts/dev-next.mjs",
    "dev:publishing-site": "npm run publishing:css && node scripts/dev-publishing-site.mjs",
    "services:telegram": "npm --prefix services/messaging/telegram run server",
    "services:telegram:install": "npm --prefix services/messaging/telegram install",
    "services:instagram": "tsx services/scraping/instagram/src/server.ts",
    "services:facebook": "tsx services/scraping/facebook/src/server.ts",
    "services:publishing": "tsx services/publishing/queue-runner/server/index.ts",
    "publishing:companion": "node scripts/run-publishing-companion.mjs",
    "publishing:companion:hidden": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-publishing-companion-hidden.ps1",
    "publishing:companion:once": "npm run services:publishing",
    "publishing:brand-assets": "node scripts/build-publishing-brand-assets.mjs",
    "publishing:extension:validate": "node scripts/validate-publishing-extension.mjs",
    "publishing:extension:open": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-publishing-extension.ps1",
    "publishing:extension:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-publishing-extension.ps1",
    "publishing:desktop:install": "npm --prefix apps/publishing-companion-desktop install",
    "publishing:desktop:start": "npm --prefix apps/publishing-companion-desktop start",
    "publishing:desktop:make": "npm --prefix apps/publishing-companion-desktop run make",
    "publishing:desktop:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-publishing-companion.ps1",
    "publishing:release:windows": "npm run publishing:brand-assets && npm run publishing:extension:validate && npm run publishing:extension:package && npm run publishing:desktop:make && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/collect-publishing-release-artifacts.ps1",
    "publishing:install-startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-publishing-startup.ps1",
    "publishing:uninstall-startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-publishing-startup.ps1",
    "server-architecture:dev": "node --env-file-if-exists=services/automation-server/.env.local --import tsx services/automation-server/src/server.ts",
    "server-architecture:db:migrate": "node --env-file-if-exists=services/automation-server/.env.local --import tsx services/automation-server/src/migrate.ts",
    "server-architecture:preflight": "node --env-file-if-exists=services/automation-server/.env.local --import tsx services/automation-server/src/preflight.ts",
    "server-architecture:status": "node --env-file-if-exists=services/automation-server/.env.local --import tsx services/automation-server/src/status.ts",
    "server-architecture:build": "tsc --noEmit -p services/automation-server/tsconfig.json",
    "test:server-architecture": "node --import tsx --test services/automation-server/src/config.test.ts services/automation-server/src/contracts.test.ts services/automation-server/src/database.test.ts services/automation-server/src/job-store.test.ts services/automation-server/src/login-manager.test.ts services/automation-server/src/profile-store.test.ts services/automation-server/src/publishing-dry-run-worker.test.ts services/automation-server/src/publishing-preview-worker.test.ts services/automation-server/src/publishing-live-worker.test.ts services/automation-server/src/server.test.ts",
    "server-architecture:check": "npm run test:server-architecture && npm run server-architecture:build",
    "test:publishing": "node --import tsx --test lib/database-document-store.test.js src/platform/server/automation-server-bridge.test.js src/platform/server/publishing-central-store.test.js src/platform/server/service-request-auth.test.js services/publishing/queue-runner/server/content-preflight.test.ts services/publishing/queue-runner/server/external-browser-layout.test.ts services/publishing/queue-runner/server/manual-login.test.ts services/publishing/queue-runner/server/publisher-ui-guards.test.ts services/publishing/queue-runner/server/publishing-api.test.ts services/publishing/queue-runner/server/risk-classifier.test.ts services/publishing/queue-runner/server/safety-governor.test.ts services/publishing/queue-runner/server/session-storage.test.ts && npm run publishing:extension:validate && node scripts/build-publishing-companion-runtime.mjs",
    "test:instagram": "node --import tsx --test services/scraping/instagram/src/scraper.test.ts services/scraping/instagram/src/companion-jobs.test.ts services/scraping/instagram/src/growth-advisor.test.ts services/scraping/instagram/src/growth-advisor-jobs.test.ts services/scraping/instagram/console/src/profileComparison.test.js",
    "test:facebook": "node --import tsx --test services/scraping/facebook/src/scraper.test.ts services/scraping/facebook/src/companion-jobs.test.ts",
    "test:whatsapp": "node --test services/messaging/whatsapp/src/lib/wa/provider.test.js services/messaging/whatsapp/src/whatsapp-integration.test.js",
    "publishing:css": "node services/publishing/queue-runner/scripts/scope-css.mjs",
    "services:install": "npm run services:telegram:install",
    "telegram:console:build": "node scripts/build-telegram-console.mjs",
    "telegram:dashboard": "npm run services:telegram",
    "dev:telegram": "npm run dev",
    "dev:whatsapp": "npm run dev",
    "dev:messaging": "npm run dev",
    "dev:instagram": "npm run dev",
    "dev:facebook": "npm run dev",
    "build": "npm run publishing:css && node scripts/copy-telegram-console.mjs && node scripts/build-next.mjs",
    "db:migrate:platform": "node --import tsx scripts/migrate-platform-database.mjs",
    "db:migrate:whatsapp": "node scripts/migrate-whatsapp-database.mjs",
    "seed": "node scripts/seed.js",
    "rbac:migrate:dry-run": "node scripts/migrate-central-rbac.mjs",
    "rbac:migrate:apply": "node scripts/migrate-central-rbac.mjs --apply",
    "test:rbac": "node --import tsx --test src/platform/server/access-policy.test.js src/platform/server/billing-policy.test.js lib/service-access-token.test.js lib/team-testing-access.test.js lib/trial-usage-limit.test.ts",
    "preview": "next start -H 127.0.0.1 -p 4173"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@netlify/blobs": "^10.7.12",
    "@netlify/functions": "^5.3.0",
    "@sparticuz/chromium": "^149.0.0",
    "animejs": "^4.5.0",
    "big-integer": "^1.6.52",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.16",
    "next": "^15.5.21",
    "node-cron": "^4.6.0",
    "playwright-core": "^1.61.1",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0",
    "telegram": "^2.26.22",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "postcss": "^8.5.10",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "concurrently": "^9.2.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.0",
    "typescript": "5.8.2"
  }
}
